# Seed Viewer — path configuration
# Copy to ~/.seed-viewer.env and adjust for your machine.
#
# macOS:   /Users/<you>/.seed-viewer.env
# Windows: C:\Users\<you>\.seed-viewer.env
#
# Leave a value blank to use the default shown in the comment.

# Root of the Google Drive project folder
# Default macOS:   /Volumes/SATOSHI_DRIVE/SATOSHI
# Default Windows: G:\Shared drives\SATOSHI_DRIVE\SATOSHI
SF_DRIVE_ROOT=

# Root of all shot folders (PULL_PT* batches + new SEQUENCE/SHOT structure)
# Default: <SF_DRIVE_ROOT>/_SHOTS
SF_SHOTS_ROOT=

# Leave empty — ffmpeg is bundled inside the app
SF_FFMPEG_EXE=
